+  // Marmalade STT (#53): kissfft's mixed-radix real FFT. The radix-2 FFT
+  // from whisper.cpp used here before ends in a naive O(N^2) DFT, with a
+  // sin and a cos per term, when N is not a power of two: the 400-point
+  // frame took ~100x longer.
+  rfft_ = std::make_unique<Rfft>(opts_.frame_opts.PaddedWindowSize());
 }
 
