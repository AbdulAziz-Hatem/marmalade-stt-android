+// Marmalade STT (#54): run options that a Cancel() of the stream terminates
+// for as long as this object lives. A terminated run throws Ort::Exception.
+class CancellableRun {
+ public:
+  explicit CancellableRun(OfflineStream *s) : s_(s) {
+    s_->SetActiveRun(&run_options_);
+  }
+  ~CancellableRun() { s_->ClearActiveRun(); }
+  CancellableRun(const CancellableRun &) = delete;
+  CancellableRun &operator=(const CancellableRun &) = delete;
+
+  const Ort::RunOptions *Get() const { return &run_options_; }
+
+ private:
+  OfflineStream *s_;
+  Ort::RunOptions run_options_;
+};
