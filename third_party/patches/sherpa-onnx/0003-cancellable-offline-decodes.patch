@@ -1030,6 +1030,12 @@
       break;
     }
 
+    // Marmalade STT (#49): a cancelled decode stops at the next step,
+    // keeping the tokens so far.
+    if (stream->IsCancelled()) {
+      break;
+    }
+
     if (step + 1 == max_new_tokens) {
       SHERPA_ONNX_LOGE(
           "Result is truncated. max_new_tokens %d is too small for "
--- a/sherpa-onnx/csrc/offline-recognizer-whisper-impl.h
