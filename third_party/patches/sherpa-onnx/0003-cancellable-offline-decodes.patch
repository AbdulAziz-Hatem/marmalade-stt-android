+// Marmalade STT (#49): may be called from any thread while a decode of this
+// stream runs; the caller keeps the stream alive until that decode returns.
+SHERPA_ONNX_EXTERN_C
+JNIEXPORT void JNICALL Java_com_k2fsa_sherpa_onnx_OfflineStream_cancel(
+    JNIEnv * /*env*/, jobject /*obj*/, jlong ptr) {
+  reinterpret_cast<sherpa_onnx::OfflineStream *>(ptr)->Cancel();
+}
