    <!-- Krótki opis silnika. Nazwy silników i modeli bez zmian. -->
    <string name="engine_desc_parakeet_ultra">Parakeet TDT 0.6B v3 dotrenowany przez Moondream: te same 25 języków, wykrywanych automatycznie.</string>
    <string name="engine_desc_parakeet_110m">Mały angielski model NVIDIA: ułamek rozmiaru pozostałych Parakeetów i do tego szybki.</string>
    <string name="engine_desc_parakeet_ja">Japoński model NVIDIA: najdokładniejszy dla japońskiego i dużo szybszy niż Whisper. Wstawia mało przecinków.</string>
    <string name="engine_desc_canary_180m">Malutki model NVIDIA typu encoder-decoder: angielski, hiszpański, niemiecki i francuski. Wybierz język; model sam go nie wykryje.</string>
    <string name="engine_desc_nemotron_35">Strumieniowy model NVIDIA dla hindi, arabskiego i wietnamskiego: tekst pojawia się w trakcie mówienia.</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo, wielojęzyczny. Najdokładniejszy Whisper. Tekst pojawia się, gdy robisz pauzę.</string>
    <string name="engine_desc_granite">Angielski model CTC firmy IBM: najdokładniejszy w naszych testach po angielsku. Wielkie litery i interpunkcję dodaje własny formater aplikacji.</string>
    <string name="engine_desc_qwen3">Model offline firmy Alibaba z małym dekoderem opartym na modelu językowym: 30 języków, wykrywanych automatycznie, i najdokładniejszy dla chińskiego. Tekst pojawia się, gdy robisz pauzę.</string>
