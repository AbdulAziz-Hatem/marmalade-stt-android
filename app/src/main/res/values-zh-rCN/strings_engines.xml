    <!-- Engine summaries -->
    <string name="engine_desc_parakeet_ultra">Moondream 后训练的 Parakeet TDT 0.6B v3：支持同样的 25 种语言，自动检测。</string>
    <string name="engine_desc_parakeet_110m">NVIDIA 的小型英语模型：体积只有其他 Parakeet 的一小部分，速度快。</string>
    <string name="engine_desc_parakeet_ja">NVIDIA 的日语模型：日语识别最准确，速度也比 Whisper 快得多。逗号用得较少。</string>
    <string name="engine_desc_canary_180m">NVIDIA 的微型编码器-解码器模型：支持英语、西班牙语、德语和法语。需要手动选择语言，它无法自动检测。</string>
    <string name="engine_desc_nemotron_35">NVIDIA 的流式模型，支持印地语、阿拉伯语和越南语：边说边出文字。</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo，多语言。最准确的 Whisper。你停顿时才出现文字。</string>
    <string name="engine_desc_granite">IBM 的英语 CTC 模型：在我们的英语测试中最准确。大写字母和标点由应用自带的格式化器添加。</string>
    <string name="engine_desc_qwen3">Alibaba 的离线模型，带一个小型语言模型解码器：支持 30 种语言，自动检测。你停顿时才出现文字。</string>
    <string name="engine_desc_qwen3_users">Alibaba 的中文和韩语模型，带一个小型语言模型解码器：中文识别最准确。你停顿时才出现文字。</string>
