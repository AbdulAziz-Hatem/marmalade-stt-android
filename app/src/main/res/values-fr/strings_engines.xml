    <!-- Résumé d'une ligne de chaque moteur -->
    <string name="engine_desc_parakeet_ultra">Parakeet TDT 0.6B v3 post-entraîné par Moondream&#160;: les mêmes 25 langues, détectées automatiquement.</string>
    <string name="engine_desc_parakeet_110m">Le petit modèle anglais de NVIDIA&#160;: une fraction de la taille des autres Parakeet, et rapide.</string>
    <string name="engine_desc_parakeet_ja">Le modèle japonais de NVIDIA&#160;: le plus précis pour le japonais, et bien plus rapide que Whisper. Il met peu de virgules.</string>
    <string name="engine_desc_canary_180m">Le minuscule modèle encodeur-décodeur de NVIDIA&#160;: anglais, espagnol, allemand et français. Choisissez la langue&#160;; il ne sait pas la détecter.</string>
    <string name="engine_desc_nemotron_35">Le modèle en streaming de NVIDIA pour le hindi, l\'arabe et le vietnamien&#160;: le texte apparaît pendant que vous parlez.</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo, multilingue. Le Whisper le plus précis. Le texte apparaît quand vous faites une pause.</string>
    <string name="engine_desc_granite">Le modèle CTC anglais d\'IBM&#160;: le plus précis dans nos tests en anglais. Les majuscules et la ponctuation sont ajoutées par l\'application elle-même.</string>
    <string name="engine_desc_qwen3">Le modèle hors ligne d\'Alibaba, avec un petit décodeur de type modèle de langage&#160;: 30 langues, détectées automatiquement. Le texte apparaît quand vous faites une pause.</string>
    <string name="engine_desc_qwen3_users">Le modèle d\'Alibaba pour le chinois et le coréen, avec un petit décodeur de type modèle de langage&#160;: le plus précis pour le chinois. Le texte apparaît quand vous faites une pause.</string>
