    <!-- Resumen de cada motor -->
    <string name="engine_desc_parakeet_ultra">Parakeet TDT 0.6B v3 con entrenamiento adicional de Moondream: los mismos 25 idiomas, detectados automáticamente.</string>
    <string name="engine_desc_parakeet_110m">El modelo pequeño de NVIDIA para inglés: una fracción del tamaño de los otros Parakeet, y rápido.</string>
    <string name="engine_desc_parakeet_ja">El modelo japonés de NVIDIA: el más preciso para japonés y mucho más rápido que Whisper. Pone pocas comas.</string>
    <string name="engine_desc_canary_180m">El diminuto modelo codificador-decodificador de NVIDIA: inglés, español, alemán y francés. Elige el idioma; no puede detectarlo.</string>
    <string name="engine_desc_nemotron_35">El modelo de streaming de NVIDIA para hindi, árabe y vietnamita: el texto aparece mientras hablas.</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo, multilingüe. El Whisper más preciso. El texto aparece cuando haces una pausa.</string>
    <string name="engine_desc_granite">El modelo CTC de IBM para inglés: el más preciso en nuestras pruebas en inglés. Las mayúsculas y la puntuación las pone el formateador propio de la app.</string>
    <string name="engine_desc_qwen3">El modelo sin conexión de Alibaba con un pequeño decodificador de modelo de lenguaje: 30 idiomas, detectados automáticamente. El texto aparece cuando haces una pausa.</string>
    <string name="engine_desc_qwen3_users">El modelo de Alibaba para chino y coreano, con un pequeño decodificador de modelo de lenguaje: el más preciso para chino. El texto aparece cuando haces una pausa.</string>
