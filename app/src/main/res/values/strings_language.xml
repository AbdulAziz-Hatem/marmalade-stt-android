<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings → Recognition language (#27) -->
    <string name="settings_recognition_language">Recognition language</string>
    <!-- Auto choice; %1$s is the phone's system language, e.g. "Auto (German)" -->
    <string name="settings_recognition_language_auto">Auto (%1$s)</string>
    <!-- #42: the row's second line, under the choice -->
    <string name="settings_recognition_language_desc">Picks the recommended engine and the language it listens for. Some engines work the language out themselves.</string>

    <!-- Engine card, when the engine doesn't transcribe the recognition language; %1$s e.g. "Japanese" -->
    <string name="engine_card_language_missing">Doesn\'t transcribe %1$s</string>
    <!-- The same on the engine in use, with the engine that does; %2$s is an engine name -->
    <string name="engine_card_language_suggest">Doesn\'t transcribe %1$s. %2$s does.</string>
    <!-- On an engine that can't detect the language (Canary) while the recognition language is Auto and the
         system language isn't one it transcribes; %1$s is its languages, e.g. "English, Spanish, German, French" -->
    <string name="engine_card_language_choose">Can\'t detect the language. Choose one in Settings → Recognition language: %1$s.</string>
</resources>
