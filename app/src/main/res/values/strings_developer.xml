    <!-- Small labels (pills, tags) on engine cards and rows and the engine
         details dialog. "In use" is the pill where an installed card's Use
         button would be; "May be slow on this phone" marks an engine over the
         phone's speed budget; "Developer engine" is the dialog's wording -->
    <string name="engine_badge_in_use">In use</string>
    <string name="engine_badge_developer">Developer</string>
