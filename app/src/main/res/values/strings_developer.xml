         "Default (CPU)". CPU is ONNX Runtime's execution provider -->
    <string name="settings_developer_ort_tuning">Runtime tuning</string>
    <string name="settings_developer_ort_tuning_desc">ONNX Runtime thread spinning and core pinning, for measuring. Applies to the next engine load.</string>
