    <string name="cleanup_dictionary_to">Write instead</string>
    <string name="cleanup_dictionary_to_hint">Leave empty to delete the phrase.</string>
    <string name="cleanup_dictionary_from_breaks_export">Can\'t contain “->” or start with “#”.</string>
    <!-- Shown in the rule dialog when the left side matches another rule; %1$s is that rule's left side -->
    <string name="cleanup_dictionary_replaces">Replaces your rule for “%1$s”.</string>
    <!-- Right side of an empty-replacement rule in the list, e.g. "basically → (deleted)" -->
    <string name="cleanup_dictionary_deleted">(deleted)</string>
    <!-- TalkBack for a rule row, e.g. "teh becomes the" -->
    <string name="cleanup_dictionary_rule_description">%1$s becomes %2$s</string>
    <!-- TalkBack for a rule with an empty right side -->
    <string name="cleanup_dictionary_rule_deletes_description">%1$s is deleted</string>
