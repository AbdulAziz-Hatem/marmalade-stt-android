    <!-- Resumo de uma linha de cada motor (nomes de motores e modelos ficam como estão) -->
    <string name="engine_desc_parakeet_ultra">Parakeet TDT 0.6B v3 com pós-treinamento da Moondream: os mesmos 25 idiomas, detectados automaticamente.</string>
    <string name="engine_desc_parakeet_110m">Modelo pequeno da NVIDIA para inglês: uma fração do tamanho dos outros Parakeets, e rápido.</string>
    <string name="engine_desc_parakeet_ja">Modelo da NVIDIA para japonês: o mais preciso para japonês e muito mais rápido que o Whisper. Usa poucas vírgulas.</string>
    <string name="engine_desc_canary_180m">Modelo codificador-decodificador minúsculo da NVIDIA: inglês, espanhol, alemão e francês. Escolha o idioma; ele não consegue detectá-lo.</string>
    <string name="engine_desc_nemotron_35">Modelo de streaming da NVIDIA para híndi, árabe e vietnamita: o texto aparece enquanto você fala.</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo, multilíngue. O Whisper mais preciso. O texto aparece quando você faz uma pausa.</string>
    <string name="engine_desc_granite">Modelo CTC da IBM para inglês: o mais preciso nos nossos testes em inglês. Maiúsculas e pontuação vêm do formatador do próprio app.</string>
    <string name="engine_desc_qwen3">Modelo offline da Alibaba com um pequeno decodificador de modelo de linguagem: 30 idiomas, detectados automaticamente, e recomendado para chinês e coreano. O texto aparece quando você faz uma pausa.</string>
