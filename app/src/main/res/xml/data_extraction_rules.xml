<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup policy: exclude everything from both cloud backup and
  device-to-device transfer. Pairs with android:allowBackup="false" (which
  Android 12+ ignores for D2D transfer) in AndroidManifest.xml. D10.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
