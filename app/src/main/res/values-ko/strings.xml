    <string name="onboarding_futo_selected">FUTO Keyboard가 음성 입력에 Marmalade STT를 사용합니다</string>
    <string name="onboarding_futo_not_selected">FUTO Keyboard가 다른 음성 입력을 사용합니다</string>
