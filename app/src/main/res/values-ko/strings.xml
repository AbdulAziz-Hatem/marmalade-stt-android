    <string name="cleanup_fillers">군말 제거</string>
    <string name="cleanup_fillers_desc">“um”, “uh”, “er”, “hmm” 같은 군말을 제거합니다. “umbrella”처럼 실제 단어는 그대로 둡니다.</string>
