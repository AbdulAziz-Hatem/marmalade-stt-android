    <!-- Engine summaries. Engine and model names stay as they are. -->
    <string name="engine_desc_parakeet_ultra">Parakeet TDT 0.6B v3 dotrénovaný společností Moondream: stejných 25 jazyků, které rozpozná automaticky.</string>
    <string name="engine_desc_parakeet_110m">Malý anglický model od NVIDIA: zlomek velikosti ostatních modelů Parakeet, a k tomu rychlý.</string>
    <string name="engine_desc_parakeet_ja">Japonský model od NVIDIA: pro japonštinu nejpřesnější a mnohem rychlejší než Whisper. Píše málo čárek.</string>
    <string name="engine_desc_canary_180m">Drobný model encoder-decoder od NVIDIA: angličtina, španělština, němčina a francouzština. Jazyk musíte vybrat, sám ho nerozpozná.</string>
    <string name="engine_desc_nemotron_35">Streamovací model od NVIDIA pro hindštinu, arabštinu a vietnamštinu: text se objevuje, zatímco mluvíte.</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo, vícejazyčný. Nejpřesnější Whisper. Text se objeví, když se odmlčíte.</string>
    <string name="engine_desc_granite">Anglický model CTC od IBM: nejpřesnější v našich testech v angličtině. Velká písmena a interpunkci doplňuje vlastní formátovač aplikace.</string>
    <string name="engine_desc_qwen3">Offline model od společnosti Alibaba s malým dekodérem založeným na jazykovém modelu: 30 jazyků, které rozpozná automaticky, a doporučený pro čínštinu a korejštinu. Text se objeví, když se odmlčíte.</string>
