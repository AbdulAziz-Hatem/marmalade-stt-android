    <!-- Engine summaries -->
    <string name="engine_desc_parakeet_ultra">Parakeet TDT 0.6B v3 do Moondream huấn luyện thêm: vẫn cùng 25 ngôn ngữ, tự động phát hiện.</string>
    <string name="engine_desc_parakeet_110m">Mô hình tiếng Anh nhỏ của NVIDIA: kích thước chỉ bằng một phần nhỏ so với các Parakeet khác, và nhanh.</string>
    <string name="engine_desc_parakeet_ja">Mô hình tiếng Nhật của NVIDIA: chính xác nhất cho tiếng Nhật và nhanh hơn Whisper nhiều. Ít dùng dấu phẩy.</string>
    <string name="engine_desc_canary_180m">Mô hình bộ mã hóa-giải mã siêu nhỏ của NVIDIA: tiếng Anh, tiếng Tây Ban Nha, tiếng Đức và tiếng Pháp. Hãy chọn ngôn ngữ; mô hình không tự phát hiện được.</string>
    <string name="engine_desc_nemotron_35">Mô hình streaming của NVIDIA cho tiếng Hindi, tiếng Ả Rập và tiếng Việt: văn bản xuất hiện ngay khi bạn nói.</string>
    <string name="engine_desc_whisper_turbo">OpenAI Whisper large-v3-turbo, đa ngôn ngữ. Whisper chính xác nhất. Văn bản xuất hiện khi bạn ngừng nói.</string>
    <string name="engine_desc_granite">Mô hình CTC tiếng Anh của IBM: chính xác nhất trong các bài kiểm tra tiếng Anh của chúng tôi. Chữ hoa và dấu câu do bộ định dạng riêng của ứng dụng thêm vào.</string>
    <string name="engine_desc_qwen3">Mô hình ngoại tuyến của Alibaba với bộ giải mã mô hình ngôn ngữ nhỏ: 30 ngôn ngữ, tự động phát hiện. Văn bản xuất hiện khi bạn ngừng nói.</string>
    <string name="engine_desc_qwen3_users">Mô hình của Alibaba cho tiếng Trung và tiếng Hàn, với bộ giải mã mô hình ngôn ngữ nhỏ: chính xác nhất cho tiếng Trung. Văn bản xuất hiện khi bạn ngừng nói.</string>
